# ─── .env.example (raíz) ──────────────────────────────────────────────────────
# Copia como ".env" y ajusta los valores.
# El .env real NO va a Git.

# ─── Docker desarrollo ────────────────────────────────────────────────────────
POSTGRES_USER=eduparche_user
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=eduparche_dev

PGADMIN_EMAIL=admin@eduparche.co
PGADMIN_PASSWORD=cambia-esta-contraseña

# ─── Base de datos (producción) ───────────────────────────────────────────────
DB_USER="eduparche_user"
DB_PASSWORD="contraseña-segura"
DB_NAME="eduparche_prod"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="secreto-aleatorio-de-64-caracteres-minimo"

# ─── URLs públicas ────────────────────────────────────────────────────────────
FRONTEND_URL="https://tudominio.com"
NEXT_PUBLIC_API_URL="https://api.tudominio.com/api"
