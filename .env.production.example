# ─── Producción (.env.production) ────────────────────────────────────────────
# En Vercel/Railway/Render estas variables se configuran en el dashboard.

# Base de datos (ej: Neon, Railway, Supabase)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"
DB_USER="eduparche_user"
DB_PASSWORD="password-muy-seguro"
DB_NAME="eduparche_prod"

# JWT (genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="secreto-de-produccion-min-64-caracteres-muy-aleatorio"

# URL pública del backend (la que ve el browser del usuario)
NEXT_PUBLIC_API_URL="https://api.eduparche.co"
