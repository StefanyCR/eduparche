# ─── backend/.env.example ─────────────────────────────────────────────────────
# Plantilla de variables de entorno del backend.
# Copia este archivo como ".env" y reemplaza los valores con los tuyos.
#
#   cp .env.example .env
#
# Este archivo SÍ va a Git (sin valores reales).

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001

# ─── Base de datos ────────────────────────────────────────────────────────────
# Dev local con Docker:
#   DATABASE_URL="postgresql://eduparche_user:eduparche_pass@localhost:5432/eduparche_dev"
# Producción (Railway, Neon, Supabase, etc.):
#   DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_bd"
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/eduparche_dev"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# En producción usa al menos 64 caracteres aleatorios.
JWT_SECRET="reemplaza-con-un-secreto-aleatorio-de-al-menos-64-caracteres"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  http://localhost:3000
# Prod: https://tudominio.com
FRONTEND_URL="http://localhost:3000"

# ─── API pública para sistemas aliados ────────────────────────────────────────
# Claves que los sistemas externos envían en el header X-API-Key para consumir
# /api/v1/public/*. Separadas por coma para poder ROTARLAS sin cortar el
# servicio: se agrega la nueva, se avisa al aliado, y cuando migró se borra la
# vieja.
#
# Genera una clave con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si esta variable está vacía, la API pública rechaza TODAS las peticiones.
# Es a propósito: ante un error de despliegue preferimos quedar cerrados.
PARTNER_API_KEYS="clave-demo-para-postman"

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# SMTP_USER: tu dirección de Gmail
# SMTP_PASS: contraseña de aplicación (NO tu contraseña de Google)
#   myaccount.google.com → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
