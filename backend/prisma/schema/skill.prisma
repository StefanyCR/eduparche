// ============================================================
// HABILIDADES / ETIQUETAS DE CURSOS
// ============================================================

// Habilidad o etiqueta que desarrolla un curso.
// Útil para agrupar cursos y conectar estudiantes con vacantes en empleabilidad.
model Skill {
  id      String   @id @default(cuid())
  name    String   @unique // Ej: "JavaScript", "Trabajo en equipo", "Inglés B1"
  slug    String   @unique
  courses CourseSkill[]
}

// Relación M:M entre cursos y habilidades
model CourseSkill {
  courseId String
  skillId  String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
}
