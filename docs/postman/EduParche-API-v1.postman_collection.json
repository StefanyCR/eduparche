        {
          "name": "POST inscripción duplicada - 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 409', function () { pm.response.to.have.status(409); });",
                  "",
                  "pm.test('El código de error es RESOURCE_CONFLICT', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('RESOURCE_CONFLICT');",
                  "});",
                  "",
                  "// Requisito: 'enrolledStudentEmail' debe ser un estudiante YA inscrito",
                  "// en 'courseSlug'. Confirma que la restricción de unicidad se traduce",
                  "// a un 409 legible y no a un 500 de la base de datos."
                ]
              }
            }
